# ---------------------------------------------------------------------------
# J.A.R.V.I.S configuration - copy to ".env" and edit. Never commit ".env".
# Every value is optional: sensible defaults are built in.
# ---------------------------------------------------------------------------

# --- identity ---------------------------------------------------------------
JARVIS_NAME=JARVIS              # or FRIDAY
JARVIS_USER_TITLE=Sir
JARVIS_USER_NAME=               # how the assistant addresses you
JARVIS_PERSONA=jarvis           # jarvis (masculine) | friday (feminine)

# --- location & weather (Open-Meteo, no API key needed) ---------------------
JARVIS_LOCATION=Bengaluru       # blank = detect from IP, falls back below
JARVIS_FALLBACK_LOCATION=Bengaluru
JARVIS_UNITS=metric             # metric | imperial

# --- news (RSS by default; no key required) --------------------------------
JARVIS_NEWS_SOURCE=Google News India
JARVIS_NEWS_FEEDS=https://news.google.com/rss?hl=en-IN&gl=IN&ceid=IN:en
JARVIS_NEWS_API_KEY=            # optional newsapi.org key (replaces RSS)

# --- notes / reminders storage ---------------------------------------------
# JARVIS_DATA_DIR=./data

# --- email (optional; the email skill stays quiet until this is filled) ----
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_EMAIL_FROM=
JARVIS_EMAIL_DEFAULT_TO=

# --- music (desktop only) ---------------------------------------------------
JARVIS_MUSIC_DIR=               # folder with .mp3/.wav files

# --- optional LLM fallback for open questions ------------------------------
JARVIS_LLM_PROVIDER=openai      # openai (chat/completions) | anthropic
JARVIS_LLM_API_KEY=
JARVIS_LLM_MODEL=gpt-4o-mini
JARVIS_LLM_BASE_URL=            # e.g. https://api.groq.com/openai/v1 or http://localhost:11434/v1
JARVIS_LLM_MAX_TOKENS=300
JARVIS_LLM_TEMPERATURE=0.4

# --- desktop front door ----------------------------------------------------
JARVIS_CHROME_PATH=             # blank = auto-detect
JARVIS_VOICE_RATE=180
JARVIS_VOICE_INDEX_MASCULINE=0
JARVIS_VOICE_INDEX_FEMININE=1
JARVIS_WAKE_WORD=               # e.g. "jarvis" - ignore speech until it is heard

# --- optional face unlock (desktop) ----------------------------------------
JARVIS_REQUIRE_FACE_UNLOCK=false
JARVIS_FACE_MODEL_PATH=Face-Recognition/trainer/trainer.yml
JARVIS_FACE_CASCADE_PATH=Face-Recognition/haarcascade_frontalface_default.xml
JARVIS_FACE_OWNER_NAME=

# --- server ----------------------------------------------------------------
JARVIS_WEB_HOST=0.0.0.0
JARVIS_WEB_PORT=8000
# JARVIS_API_TOKEN=            # when set, API calls need the X-JARVIS-Token header

# --- misc ------------------------------------------------------------------
JARVIS_OFFLINE=false           # true = never touch the network (tests, demos)
JARVIS_LOG_LEVEL=INFO
